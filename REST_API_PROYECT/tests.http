@adminUser = admin
@adminPass = 12345678

### Login de administrador (ejecutar primero: guarda la cookie y el csrfToken)
# @name login
POST /api/v1/auth/login HTTP/1.1
host: localhost:3000
Content-Type: application/json

{
  "username": "{{adminUser}}",
  "password": "{{adminPass}}"
}


### Ver la sesion actual
GET /api/v1/auth/me HTTP/1.1
host: localhost:3000


### Verificar que el API y la base de datos estan activas
GET /api/v1/health HTTP/1.1
host: localhost:3000


### Listar roles validos
GET /api/v1/roles HTTP/1.1
host: localhost:3000


### Listar estados validos
GET /api/v1/estados HTTP/1.1
host: localhost:3000


### Listar tipos de roster validos
GET /api/v1/tipos-roster HTTP/1.1
host: localhost:3000


### Listar todos los jugadores
GET /api/v1/jugadores HTTP/1.1
host: localhost:3000


### Listar jugadores con filtros 
GET /api/v1/jugadores?search=fak HTTP/1.1
host: localhost:3000


### Crear un jugador 
# @name crearJugador
POST /api/v1/jugadores HTTP/1.1
host: localhost:3000
Content-Type: application/json
X-CSRF-Token: {{login.response.body.csrfToken}}

{
  "nickname": "Caps",
  "nombre_real": "Rasmus Winther",
  "pais": "Dinamarca",
  "rol": "Mid",
  "estado": "activo"
}


### Ver el detalle del jugador recien creado
GET /api/v1/jugadores?search=Caps HTTP/1.1
host: localhost:3000

###

### Actualizar el jugador recien creado
PUT /api/v1/jugadores/{{crearJugador.response.body.id}} HTTP/1.1
host: localhost:3000
Content-Type: application/json
X-CSRF-Token: {{login.response.body.csrfToken}}

{
  "pais": "Noruega",
  "estado": "activo"
}


### Listar todos los rosters (con cantidad de jugadores)
GET /api/v1/rosters HTTP/1.1
host: localhost:3000


### Listar rosters con filtros
GET /api/v1/rosters?tipo=Principal&temporada=2027 HTTP/1.1
host: localhost:3000


### Crear un roster
# @name crearRoster
POST /api/v1/rosters HTTP/1.1
host: localhost:3000
Content-Type: application/json
X-CSRF-Token: {{login.response.body.csrfToken}}

{
  "nombre": "Roster de prueba",
  "juego": "League of Legends",
  "tipo": "Principal",
  "temporada": "2026"
}



### Ver el detalle del roster recien creado 
GET /api/v1/rosters/{{crearRoster.response.body.id}} HTTP/1.1
host: localhost:3000


### Actualizar el roster recien creado
PUT /api/v1/rosters/{{crearRoster.response.body.id}} HTTP/1.1
host: localhost:3000
Content-Type: application/json
X-CSRF-Token: {{login.response.body.csrfToken}}

{
  "nombre": "Roster no tan prueba",
  "tipo": "Academy",
  "temporada": "2027"
}

### Asignar a un jugador al roster creado, como titular
POST /api/v1/rosters/{{crearRoster.response.body.id}}/jugadores HTTP/1.1
host: localhost:3000
Content-Type: application/json
X-CSRF-Token: {{login.response.body.csrfToken}}

{
  "id_jugador": 13,
  "rol_en_roster": "Titular"
}


### Listar los jugadores del roster
GET /api/v1/rosters/{{crearRoster.response.body.id}}/jugadores HTTP/1.1
host: localhost:3000


### Cambiar al jugador de Titular a Suplente
PUT /api/v1/rosters/{{crearRoster.response.body.id}}/jugadores/13 HTTP/1.1
host: localhost:3000
Content-Type: application/json
X-CSRF-Token: {{login.response.body.csrfToken}}

{
  "rol_en_roster": "Suplente"
}


### Quitar al jugador del roster 
DELETE /api/v1/rosters/{{crearRoster.response.body.id}}/jugadores/13 HTTP/1.1
host: localhost:3000
X-CSRF-Token: {{login.response.body.csrfToken}}



# ===========================================================================


### Eliminar el roster de prueba
DELETE /api/v1/rosters/{{crearRoster.response.body.id}} HTTP/1.1
host: localhost:3000
X-CSRF-Token: {{login.response.body.csrfToken}}


### Eliminar el jugador de prueba
DELETE /api/v1/jugadores/{{crearJugador.response.body.id}} HTTP/1.1
host: localhost:3000
X-CSRF-Token: {{login.response.body.csrfToken}}

# ===========================================================================
# Correciones con el Admin
# ==========================================================================

### [Debe dar 403] Escritura con sesion pero SIN token CSRF
POST /api/v1/jugadores HTTP/1.1
host: localhost:3000
Content-Type: application/json

{
  "nickname": "SinCsrf",
  "rol": "Top"
}


### Cerrar sesion
POST /api/v1/auth/logout HTTP/1.1
host: localhost:3000


### [Debe dar 401] Escritura SIN sesion (ejecutar despues del logout)
POST /api/v1/jugadores HTTP/1.1
host: localhost:3000
Content-Type: application/json

{
  "nickname": "SinSesion",
  "rol": "Top"
}


### [Debe dar 401] Ver la sesion actual despues del logout
GET /api/v1/auth/me HTTP/1.1
host: localhost:3000

### Login con Google: debe dar 302 hacia accounts.google.com
# @no-redirect
GET /api/v1/auth/google/login HTTP/1.1
host: localhost:3000


### Callback con state invalido: debe dar 302 hacia /login?error=google
# @no-redirect
GET /api/v1/auth/google/callback?code=x&state=x HTTP/1.1
host: localhost:3000